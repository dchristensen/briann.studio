---
import { getEmDashCollection } from "emdash";
import { formatDate } from "../utils/date";
import YouTubeVideo from "./YouTubeVideo.astro";

const { entries: events, cacheHint } = await getEmDashCollection("events", {
  limit: 6,
});

Astro.cache.set(cacheHint);
---

<header class="major">
  <h2>Recent Events</h2>
  <span class="byline">Recitals, performances and other events</span>
</header>
<div class="row">
  <div class="12u events-container">
    {
      events
        .map((e) => e.data)
        .sort((a, b) => b.date.localeCompare(a.date))
        .map((event) => (
          <div class="event">
            {event.youtube && (
              <div class="event-video">
                <YouTubeVideo url={event.youtube} />
              </div>
            )}
            <div>
              <h3>{event.title}</h3>
              <p>{formatDate(event.date)}</p>
            </div>
          </div>
        ))
    }
  </div>
</div>
