---
import { getEmDashCollection } from "emdash";
import ImageGallery, { type GalleryItem } from "react-image-gallery";
import "react-image-gallery/styles/image-gallery.css";

const { entries: galleryItems, cacheHint } = await getEmDashCollection("gallery_images");

const images = galleryItems
  .sort(() => Math.random() - 0.5) // Shuffle the images
  .map(
    (item): GalleryItem => ({
      original: item.data.image.src ?? `/_emdash/api/media/file/${item.data.image.meta.storageKey}`,
      originalWidth: String(item.data.image.width ?? 0),
      originalHeight: String(item.data.image.height ?? 0),
      originalAlt: item.data.image.alt,
    }),
  );

Astro.cache.set(cacheHint);
---

<div class="wrapper style2">
  <section class="container">
    <div class="row">
      <section class="12u">
        <ImageGallery client:load items={images} autoPlay={true} showFullscreenButton={false} slideInterval={5000} />
      </section>
    </div>
  </section>
</div>
